{
  // Scripts de Node (validador del catálogo): se ejecutan con --experimental-strip-types,
  // así que los imports llevan la extensión .ts.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["scripts", "src/catalogo"]
}
