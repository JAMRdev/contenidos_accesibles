{
  "name": "contenidos-accesibles-d1-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Worker pasarela entre el backend (Railway) y Cloudflare D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  },
  "allowScripts": {
    "workerd@1.20260930.2": true
  }
}
