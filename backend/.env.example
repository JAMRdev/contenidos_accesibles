# Configuración del proyecto
PROJECT_NAME="InnovaLab - Asistente de Accesibilidad"
API_V1_STR=/api/v1

# --- Conexión de IA principal (Groq, obtené la key en https://console.groq.com/keys) ---
# En cada arranque se crea/actualiza esta conexión con la prioridad más alta.
# Editarla o borrarla desde /admin no persiste. Las conexiones de respaldo se
# gestionan desde /admin. Solo AI_API_KEY es obligatoria; el resto tiene default.
AI_API_KEY=
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-120b
# AI_CONNECTION_LABEL="IL-1 gpt-oss-120b - PROD"

# --- Panel de Administración (/admin): cuenta del .env, siempre con rol admin ---
ADMIN_USERNAME=admin
# Obligatoria: sin ella la app no arranca. Usá una contraseña fuerte y propia.
ADMIN_PASSWORD=

# --- Login del panel /admin con Clerk (aplicación de Clerk propia del panel, separada de la de docentes) ---
# ADMIN_AUTH: local (solo usuario/contraseña del .env) | clerk (solo Clerk) | ambos (Clerk + respaldo local)
# En local se usa "local"; en Railway, "ambos" con las tres claves de Clerk.
ADMIN_AUTH=local
# Claves de la aplicación de Clerk del panel (Dashboard > Configure > API keys). Sin las tres, solo hay login local.
ADMIN_CLERK_PUBLISHABLE_KEY=
ADMIN_CLERK_SECRET_KEY=
# JWT public key en formato PEM (Dashboard > API keys > Show JWT public key). En el .env: entre comillas,
# en una línea con \n o en varias líneas. En el panel de Railway se puede pegar tal cual (se normaliza al leerla).
ADMIN_CLERK_JWT_KEY=
# Usuarios de GitHub con acceso, separados por comas. Se cargan al arrancar si no existen;
# después se administran desde la pestaña Usuarios del panel. Admin = todo; viewers = solo lectura.
ADMIN_GITHUB_ADMINS=
ADMIN_GITHUB_VIEWERS=

# --- Entorno: development | staging | production ---
# En development /docs, /redoc y openapi.json quedan abiertos. En staging/production
# exigen la sesión del panel /admin (Clerk o ADMIN_USERNAME / ADMIN_PASSWORD).
ENVIRONMENT=development

# --- Base de datos local (SQLite) de API Keys y contadores de uso ---
# Solo con DATABASE_BACKEND=sqlite (desarrollo). En Railway se usa D1 (ver abajo) y esta
# variable no se define: el disco del contenedor se borra en cada deploy.
DATABASE_PATH=app_data.db

# --- Cloudflare D1 vía Worker pasarela (backend/d1-gateway) ---
# sqlite (por defecto, local como siempre) | d1 (producción, o desde local para probar el
# backend completo contra Cloudflare). Con d1 son obligatorias la URL y el token, y el esquema
# tiene que estar aplicado en D1 (npm run migrate:local / migrate:remote en d1-gateway/).
DATABASE_BACKEND=sqlite
# URL del Worker: http://127.0.0.1:8787 con `npm run dev`, o https://<worker>.workers.dev
D1_GATEWAY_URL=
# Secreto compartido con el Worker (en el Worker: .dev.vars en local, `wrangler secret put` en producción)
D1_GATEWAY_TOKEN=

# Clave simétrica (Fernet) para cifrar las API keys guardadas en la DB.
# Generarla con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# --- Rate limit de los endpoints que consumen IA real (?mock=true no cuenta) ---
# Ventanas deslizantes de 1 minuto y 24 horas, por IP y globales. 0 desactiva ese límite.
# AI_RATE_LIMIT_PER_IP_MINUTE=5
# AI_RATE_LIMIT_PER_IP_DAY=50
# AI_RATE_LIMIT_GLOBAL_MINUTE=20
# AI_RATE_LIMIT_GLOBAL_DAY=500

# --- CORS ---
# Orígenes del frontend autorizados. Reemplaza la lista por defecto (localhost:3000/5173),
# así que incluí también los locales si los necesitás. Separados por comas o como lista JSON.
# BACKEND_CORS_ORIGINS=https://contenidos-accesibles.vercel.app,http://localhost:5173
# BACKEND_CORS_ORIGINS=["https://contenidos-accesibles.vercel.app","http://localhost:5173"]

# --- Web de pruebas (web/, Static Site en Render) ---
# URL pública de la web de pruebas: su origen se suma a CORS, /admin muestra el enlace y
# las llamadas desde ese origen piden el login del panel.
# TEST_WEB_URL=https://innovalab-web-pruebas.onrender.com

# URL del frontend para docentes: solo para la pestaña Estado de /admin (no toca CORS).
# Por defecto https://contenidos-accesibles.vercel.app/; vacía para no chequearlo.
# FRONTEND_URL=https://contenidos-accesibles.vercel.app/
